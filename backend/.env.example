# Copy this file to backend/.env on the server and fill in real values, then
# `pm2 restart planner-backend`. The server's .env is never overwritten by deploys.

PORT=5002

# Public origin the app is served from (nginx proxies /api to this backend).
FRONTEND_URL=https://70-42-223-139.sslip.io
BACKEND_URL=https://70-42-223-139.sslip.io

# Google Calendar OAuth — Web client in Google Cloud Console.
# Authorized redirect URI must be exactly:
#   https://70-42-223-139.sslip.io/api/calendar/google/callback
# In Testing mode the OAuth consent screen needs your Gmail listed under Test
# Users, and `https://www.googleapis.com/auth/calendar.readonly` listed under
# Scopes. See ../CALENDAR_SETUP.md for the full walkthrough.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft Graph (Outlook) OAuth — Azure AD app registration on the "common"
# tenant so it accepts personal + work/school accounts.
# Redirect URI must be exactly:
#   https://70-42-223-139.sslip.io/api/calendar/outlook/callback
# Delegated API permissions needed: Calendars.Read, User.Read, offline_access.
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# Garmin Connect (Health tab). Plain sign-in through the garminconnect Python
# client; the password is used for the first sign-in and whenever the saved
# tokens stop refreshing. Tokens live in backend/garmin-state/ (never pushed).
GARMIN_EMAIL=
GARMIN_PASSWORD=
# Optional overrides (defaults: backend/garmin/.venv/bin/python, backend/garmin-state)
# GARMIN_PYTHON=
# GARMIN_STATE_DIR=

# Home Workouts snapshot (Workout App tab). The Mac rsyncs
# backend/workout-state/home_workouts.json here; the server only reads it.
# WORKOUT_STATE_DIR=

# Phone push of Apple Health workouts (Workout tab, POST /api/workout/health). The API has no
# auth, so this one route checks the X-Workout-Token header against this value. Generate with
# `openssl rand -hex 32`, paste the same value into the phone's Shortcut, then
# `pm2 restart planner-backend --update-env`. Unset = the route answers 503.
WORKOUT_PUSH_TOKEN=
