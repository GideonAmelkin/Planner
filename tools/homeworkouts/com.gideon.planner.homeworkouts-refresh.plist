<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Every 15 seconds: ask the Planner server whether the Workout tab's Refresh button was pressed
       (refresh_watch.py, one HTTPS GET) and, when it was, run the full sync now. Same python3 as the
       hourly job, so the same Full Disk Access + Accessibility grants cover it.
       Install: cp tools/homeworkouts/com.gideon.planner.homeworkouts-refresh.plist ~/Library/LaunchAgents/
                launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.gideon.planner.homeworkouts-refresh.plist
       Reinstall after editing: launchctl bootout gui/$(id -u)/com.gideon.planner.homeworkouts-refresh, then the two lines above
       Log: the sync itself logs to ~/Library/Application Support/PlannerHomeWorkouts/sync.log -->
  <key>Label</key>
  <string>com.gideon.planner.homeworkouts-refresh</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Library/Developer/CommandLineTools/usr/bin/python3</string>
    <string>/Users/gideonamelkin/Documents/Planner/tools/homeworkouts/refresh_watch.py</string>
  </array>
  <key>StartInterval</key>
  <integer>15</integer>
  <key>StandardOutPath</key>
  <string>/Users/gideonamelkin/Library/Application Support/PlannerHomeWorkouts/refresh.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/gideonamelkin/Library/Application Support/PlannerHomeWorkouts/refresh.log</string>
</dict>
</plist>
