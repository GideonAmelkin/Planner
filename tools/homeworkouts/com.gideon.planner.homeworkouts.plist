<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- At 10:00 and 21:00 every day: open the Home Workouts Mac app, press Me > Sync Data, quit the
       app again (always, whatever the outcome), export the app, ship the snapshot to RT100.
       APP_SYNC_FORCE=1: the run goes ahead even while the user is at the keyboard. A Mac asleep at
       the time runs it on wake; a locked screen skips it until the next slot. python3 is run
       directly (no shell) so it is the one binary that needs the grants: Full Disk Access (the
       app container and this repo) and Accessibility (to click the app). Both in System
       Settings > Privacy & Security, "+" > Cmd+Shift+G > /Library/Developer/CommandLineTools/usr/bin/python3.
       Install: cp tools/homeworkouts/com.gideon.planner.homeworkouts.plist ~/Library/LaunchAgents/
                launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.gideon.planner.homeworkouts.plist
       Reinstall after editing: launchctl bootout gui/$(id -u)/com.gideon.planner.homeworkouts, then the two lines above
       Run now: launchctl kickstart -k gui/$(id -u)/com.gideon.planner.homeworkouts
       Log:     ~/Library/Application Support/PlannerHomeWorkouts/sync.log -->
  <key>Label</key>
  <string>com.gideon.planner.homeworkouts</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Library/Developer/CommandLineTools/usr/bin/python3</string>
    <string>/Users/gideonamelkin/Documents/Planner/tools/homeworkouts/sync.py</string>
    <string>--app-sync</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>APP_SYNC_FORCE</key>
    <string>1</string>
  </dict>
  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Hour</key>
      <integer>10</integer>
      <key>Minute</key>
      <integer>0</integer>
    </dict>
    <dict>
      <key>Hour</key>
      <integer>21</integer>
      <key>Minute</key>
      <integer>0</integer>
    </dict>
  </array>
  <key>StandardOutPath</key>
  <string>/Users/gideonamelkin/Library/Application Support/PlannerHomeWorkouts/launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/gideonamelkin/Library/Application Support/PlannerHomeWorkouts/launchd.log</string>
</dict>
</plist>
